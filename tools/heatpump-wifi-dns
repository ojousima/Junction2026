#!/bin/sh
# NetworkManager dispatcher: refresh Docker DNS when wlan0 connects.

[ "$1" = wlan0 ] && [ "$2" = up ] || exit 0

container=heatpump-doctor-main-1
if ! running=$(/usr/bin/docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null); then
    logger -t heatpump-wifi-dns "Container $container not available; skipping restart"
    exit 0
fi
[ "$running" = true ] || exit 0

if /usr/bin/docker restart --time 10 "$container" >/dev/null; then
    logger -t heatpump-wifi-dns "Restarted $container after wlan0 connected"
else
    logger -p user.err -t heatpump-wifi-dns "Failed to restart $container after wlan0 connected"
    exit 1
fi
